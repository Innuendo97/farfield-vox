# Normalise on checkin, check out with LF everywhere: the toolchain runs the
# same scripts on Windows and on the build host, and a stray CRLF in a shell
# script or in a hash input is a difference nobody can see while reading a diff.
* text=auto eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.ps1   text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf

# Never touched by the eol machinery, never diffed as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ktx2   binary
*.basis  binary
*.glb    binary
*.bin    binary
*.exr    binary
*.hdr    binary
*.blend  binary
*.blend1 binary
*.wasm   binary
*.ttf    binary
*.woff   binary
*.woff2  binary
